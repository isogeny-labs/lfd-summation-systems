\\ rt29.gp -- red-team (redteam-lead1): the report's own "untested prediction" at ell = 29.
\\ ell = 29: eps = (-7/29) = +1 and U_29 = -8641 with 8641 of INERT type.  Lead 1's rule predicts:
\\    End = O_K            : principally polarizable      (n = 0, eps (-1)^0 = +1)
\\    End = R(v0)          : NOT principally polarizable  (n = 1)
\\    End = R(one pair)    : principally polarizable      (n = 0)
\\ This is the opposite sign pattern to ell = 17 and 131, so it tests the eps factor of Theorem A.
\\ Method (no bnfinit of the degree-56 field K): narrow class group Cl+(K+) (bnfinit of K+, degree 28, GRH),
\\ subgroup H_gen generated by narrow classes of NORMS of prime ideals of K (split primes q of K+ -> q,
\\ inert -> q^2), grown until [Cl+ : H_gen] = 2 (CFT: [Cl+ : N Cl(K)] = 2 since K/K+ is unramified at all
\\ finite places, so then H_gen = N Cl(K)).  For O_K an explicit unimodular lattice is produced and checked
\\ by an exact 56x56 Gram determinant (independent of CFT).
\\ usage: gp -q < rt29.gp
\r rt_lib.gp

{
  my(t0 = getabstime());
  rt_init(29, 0);
  printf("  [%d ms] structure:\n", getabstime() - t0);
  rt_structure();
  rt_cmtype();
  BNR = bnrinit(BNFKP, [1, vector(NFKP.r1, i, 1)], 1);
  my(cyc = BNR.cyc);
  printf("  narrow class group Cl+(K+) = %s (order %d); class group Cl(K+) = %s\n", cyc, vecprod(cyc), BNFKP.cyc);
  \\ grow H_gen from norms of primes of K above small rational primes
  my(V = matrix(#cyc, 0), Wlist = List(), idx = vecprod(cyc), q = 1);
  while (idx > 2 && q < 3000,
    q = nextprime(q + 1);
    if (q == 7 || q == 29, next);
    my(L = idealprimedec(NFKP, q));
    for (i = 1, #L, my(u = idealfactor(NFK, rnfidealup(RNF, L[i], 1)));
      my(nq = if (#u[,1] == 2, L[i], idealpow(NFKP, L[i], 2)));
      my(c = bnrisprincipal(BNR, nq, 0));
      V = matconcat([V, c]); listput(Wlist, [u[1,1], nq]);
      idx = if (#cyc, matdet(mathnf(matconcat([V, matdiagonal(cyc)]))), 1)));
  printf("  H_gen from norms of primes of K above q <= %d: %d generators, [Cl+ : H_gen] = %d\n", q, #V, idx);
  if (idx != 2, error("H_gen did not reach index 2"));
  my(U = rt_U(29), p = abs(U));
  printf("  U_29 = %d ; p = %d prime %d ; p mod 29 = %d ; (-7/p) = %d\n", U, p, isprime(p), p % 29, kronecker(-7, p));
  my(sp = rt_special(p), L = sp[1], v0 = sp[2], pairs = sp[3]);
  printf("  primes of K above p: %d (f=%s), self-glued v0 = %s, glued pairs = %d\n", #L, Set(vector(#L, i, L[i].f)), v0, #pairs);
  my(cases = [["End = O_K", idealhnf(NFK, 1), 1], ["End = R(v0)", idealhnf(NFK, L[v0[1]]), 0],
              ["End = R(one glued pair)", idealmul(NFK, L[pairs[1][1]], L[pairs[1][2]]), 1],
              ["End = R(v0 + one pair)", idealmul(NFK, L[v0[1]], idealmul(NFK, L[pairs[1][1]], L[pairs[1][2]])), 0]]);
  for (k = 1, #cases, my(cond = cases[k][2]);
    my(big = idealmul(NFK, S7, idealmul(NFK, NFK.diff, cond)), bp = rnfidealdown(RNF, big));
    if (idealhnf(NFK, rnfidealup(RNF, bp, 1)) != idealhnf(NFK, big), error("b+ not extended"));
    my(c = bnrisprincipal(BNR, bp, 0), sol = matsolvemod(V, cyc~, c), inH = (type(sol) != "t_INT"));
    my(fa = idealfactor(NFKP, bp), art = 1);
    for (j = 1, #fa[,1], my(u = idealfactor(NFK, rnfidealup(RNF, fa[j,1], 1))); if (#u[,1] == 1 && u[1,2] == 1 && fa[j,2] % 2, art = -art));
    printf("  %-26s predicted ppav: %d | [b+] in N Cl(K): %d | Artin parity: %+d | agree: %d\n", cases[k][1], cases[k][3], inH, art, inH == cases[k][3]);
    \\ explicit certificate for End = O_K: S = prod w_i^(-e_i) with sum e_i [N w_i] = [b+], r = 1/g, (g) = b+ N(S), g >> 0
    if (inH && k == 1,
      my(S = idealhnf(NFK, 1), NS = idealhnf(NFKP, 1));
      for (i = 1, #sol, if (sol[i] % vecprod(cyc), my(e = -sol[i]);
        S = idealmul(NFK, S, idealpow(NFK, Wlist[i][1], e)); NS = idealmul(NFKP, NS, idealpow(NFKP, Wlist[i][2], e))));
      if (idealhnf(NFK, rnfidealup(RNF, NS, 1)) != idealhnf(NFK, idealmul(NFK, S, rt_cjI(S))), error("norm bookkeeping"));
      my(g = bnrisprincipal(BNR, idealmul(NFKP, bp, NS), 1));
      if (g[1] != 0*g[1], error("not narrowly principal"));
      my(gg = nfbasistoalg(NFKP, g[2]), rr = 1/gg);
      printf("    generator totally positive: %d\n", rt_sgnvec(rr) == 0*rt_sgnvec(rr));
      my(lam = nfeltmul(NFK, S7, rt_up(rr)));
      if (idealhnf(NFK, idealmul(NFK, lam, idealmul(NFK, S, rt_cjI(S)))) != idealhnf(NFK, idealinv(NFK, NFK.diff)), error("lambda S Sbar != D^-1"));
      \\ S may be fractional: scale to an integral lattice (Gram determinant is scale-invariant only up to d^(2n); use S itself)
      my(B = idealhnf(NFK, S));
      my(v = rt_verify(B, lam, "ell=29 End=O_K explicit ppav"));
      my(h = rt_hilbert(rr));
      printf("    Hilbert symbols of r: product=%d, places with -1: %s\n", h[1], h[3])));
  printf("  total time %d s\n", (getabstime() - t0)\1000);
}
