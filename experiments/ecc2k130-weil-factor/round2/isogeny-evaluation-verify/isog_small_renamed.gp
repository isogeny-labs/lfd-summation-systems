\\ Lattice-level test of the kernel theorem at small ell (Deligne modules, covariant: ker(phi) = T_B / x S_A).
\\ For isogenies x: S_A -> T_B (S_A an O_K-ideal, i.e. End maximal; T_B a principally polarized Deligne module)
\\ compute the finite R-module G = T_B / x S_A, (i) the order m_G of pi on G (all kernel points rational over
\\ F_{2^m} iff m_G | m), (ii) dim of the m0-socle {g in G[p] : (pi-lam) g = (pibar-lam) g = 0}.
\\ Claim: for every ppav target, socle_m0 > 0 and ord(lam) | m_G.  Controls: O_K-targets and a target that is
\\ non-maximal only at a glued pair (not ppav) must show isogenies with socle_m0 = 0.
\\ Also: for each ppav T_B, the lattice L = Hom_{F_{2^ell}}(B, E) and its minimum d_min = least degree of
\\ u o (Abel-Jacobi) : C -> E if B were Jac(C)  (d_min = 1 would split B over F_{2^ell}: not a Jacobian).
\r decide_ppav_renamed.gp
setrand(20261127);
MON = 0; SAMPLE = "all";
monos() = { my(out = List()); for (a = 0, 2*poldegree(NF.pol), for (b = 0, 1, listput(out, nfeltmul(NF, nfeltpow(NF, PI, a), nfeltpow(NF, PIB, b))))); Vec(out); }
latt(S, f, t) = { my(gens = matconcat(vector(#MON, k, nfeltmul(NF, MON[k], t)))); mathnf(concat(gens, idealhnf(NF, idealmul(NF, f, S)))); }
lat(S, f, lam) = {
  my(Fp = idealfactor(NF, f)[,1], H = idealhnf(NF, S), t = H[,1], tries = 0, B);
  while (1, while (!locgen(t, S, Fp), t = H * vectorv(#H, i, random(201) - 100));
    B = latt(S, f, t); tries++;
    if (denominator(gram(B, lam)) == 1 && abs(matdet(gram(B, lam))) == 1, return(B));
    t = 0; if (tries > 20000, error("no twist found")));
}
mulmat(x) = matconcat(vector(poldegree(NF.pol), i, nfeltmul(NF, x, matid(poldegree(NF.pol))[,i])));
\\ H = {x : x S subset T}, S,T as Z-bases (columns)
homlat(S, T) = {
  my(n = #S, Ti = T^-1);
  my(A = matconcat(vector(n, i, Ti * mulmat(S[,i]))~));
  my(dn = denominator(A), W = mathnf(dn * A~) / dn);
  if (#W != n, error("row space rank"));
  (W~)^-1;
}
\\ kernel data for x: S -> T
kerdata(x, S, T, p, lam) = {
  my(n = #S, C = matsolve(T, mulmat(x) * S));
  if (denominator(C) != 1, error("x S not in T"));
  my(D = abs(matdet(C)));
  if (D == 1, return([1, 1, 0, 0]));
  if (D % 2 == 0, return([D, -1, -1, -1]));
  my(P = matsolve(T, mulmat(PI) * T), Pb = matsolve(T, mulmat(PIB) * T));
  my(Ad = matadjoint(C));
  my(triv(m) = my(Pm = lift(Mod(P, D)^m)); Ad * (Pm - 1) % D == 0);
  \\ exponent bound
  my(F = factor(D), Lam = 1);
  for (i = 1, #F~, my(q = F[i,1], L = idealprimedec(NF, q)); Lam = lcm(Lam, q^F[i,2]); for (k = 1, #L, Lam = lcm(Lam, q^L[k].f - 1)));
  if (!triv(Lam), error("exponent bound failed"));
  my(fL = factor(Lam)[,1], m = Lam);
  for (i = 1, #fL, while (m % fL[i] == 0 && triv(m / fL[i]), m /= fL[i]));
  \\ m0-socle: G[p] with joint kernel of (pi - lam), (pibar - lam), over F_p
  my(soc = 0);
  if (D % p == 0,
    my(Sn = matsnf(C, 1), U = Sn[1], d = Sn[3], gens = List());
    \\ G = Z^n / C Z^n ; U C V = diag(d) ; coordinate y = U z mod d_i ; G[p] generated by U^{-1} (d_i/p) e_i
    my(Ui = U^-1);
    for (i = 1, n, if (d[i,i] % p == 0, listput(gens, Ui[,i] * (d[i,i] / p))));
    my(g = Mat(Vec(gens)));
    if (#gens,
      g = matconcat(Vec(gens));
      \\ element v in G is zero iff C^{-1} v integral ; work mod p on the F_p-space G[p] = span(g):
      \\ (pi - lam) g = g * Mpi  (in G) ; solve via coordinates: express everything in the basis g modulo C Z^n
      my(r = #gens, Bm = concat(g, C));
      my(coords(v) = my(s = matinverseimage(Bm, v)); if (#s == 0, error("not in span")); vector(r, j, Mod(s[j], p))~);
      \\ the span g + C Z^n contains (pi-lam) g since G[p] is R-stable
      my(Mp = matconcat(vector(r, j, coords((P - lam) * g[,j]))), Mb = matconcat(vector(r, j, coords((Pb - lam) * g[,j]))));
      soc = r - matrank(concat(Mp~, Mb~)~)));
  [D, m, soc, valuation(D, p)];
}
run(ell, p, nppav) = {
  initellX(ell); MON = monos();
  my(L = idealprimedec(NF, p), Pp = cmtype(1), J0 = idealinv(NF, NF.diff));
  \\ the self-glued / glued residue value lam with lam^2 = 2:
  my(cand = [i | i <- [1..#L], resid(L[i], PI) == resid(L[i], PIB) && resid(L[i], PI)^p == resid(L[i], PI)]);
  if (#cand == 0, error("no hom with pi == pibar in F_p"));
  my(mpl = minpoly(resid(L[cand[1]], PI))); if (poldegree(mpl) != 1, error("lam not in F_p"));
  my(lam = lift(-polcoef(mpl, 0)));
  printf("ell=%d p=%d lam=%d lam^2-2 mod p=%d ord(lam)=%d\n", ell, p, lam, (lam^2 - 2) % p, znorder(Mod(lam, p)));
  my(Q0 = idealhnf(NF, idealmul(NF, L[cand[1]], if (#cand > 1, L[cand[2]], 1))));
  if (#cand == 1, Q0 = idealhnf(NF, L[cand[1]]));
  printf("  conductor ideal at the pi==pibar place(s): %d prime(s), indices %s\n", #cand, cand);
  \\ ppav targets: End(T) = Z[pi,pibar] + Q0 (non-maximal at v0) if eps=-1 ; End = O_K if eps = +1
  my(eps = kronecker(-7, ell), targets = List());
  if (eps == -1,
    my(r = decide(idealmul(NF, J0, idealinv(NF, Q0)), Pp));
    printf("  ppav classes with End = R(v0): %d\n", r[4]);
    for (k = 1, min(nppav, #r[5]), my(B = lat(r[5][k][1], Q0, r[5][k][2])); verify(B, r[5][k][2], Pp, "ppav target"); listput(targets, [B, r[5][k][2], "ppav(R_v0)"])),
    my(r = decide(J0, Pp));
    printf("  ppav classes with End = O_K: %d\n", r[4]);
    for (k = 1, min(nppav, #r[5]), my(B = idealhnf(NF, r[5][k][1])); verify(B, r[5][k][2], Pp, "ppav target (O_K)"); listput(targets, [B, r[5][k][2], "ppav(O_K)"])));
  \\ control targets (not ppav): O_K-ideals; lattice non-maximal at a glued pair only
  listput(targets, [idealhnf(NF, 1), 0, "control O_K"]);
  listput(targets, [idealhnf(NF, BNF.gen[1]), 0, "control O_K-ideal gen1"]);
  \\ glued pair for inert type: places of degree 2 with equal residues of (pi,pibar)
  my(pairs = List()); for (i = 1, #L, for (j = i+1, #L, if (L[i].f == L[j].f && minpoly(resid(L[i], PI)) == minpoly(resid(L[j], PI)) && minpoly(resid(L[i], PIB)) == minpoly(resid(L[j], PIB)) && !setsearch(Set(cand), i) && !setsearch(Set(cand), j), listput(pairs, [i, j]))));
  if (#pairs && eps == -1, my(Pq = idealmul(NF, L[pairs[1][1]], L[pairs[1][2]])); my(Tq = latt(idealhnf(NF, 1), Pq, nfalgtobasis(NF, 1))); if (!stable(Tq, PI) || !stable(Tq, PIB), error("glued-pair control not R-stable")); listput(targets, [Tq, 0, "control glued-pair-only (not ppav)"]));
  my(sources = [idealhnf(NF, 1), idealhnf(NF, BNF.gen[1])]);
  for (it = 1, #targets, my(T = targets[it][1]); if (SAMPLE != "all" && SAMPLE != targets[it][3], next);
    for (is = 1, #sources, my(S = sources[is], H = qflll(homlat(S, T)), Hb = homlat(S, T) * H, stats = [0, 0, 0, 0]);
      \\ sample: LLL basis vectors + random small combinations
      my(xs = List()); for (k = 1, #Hb, listput(xs, Hb[,k]));
      for (k = 1, 40, listput(xs, Hb * vectorv(#Hb, i, random(5) - 2)));
      for (k = 1, #xs, my(x = xs[k]); if (x == 0, next);
        my(kd = kerdata(x, S, T, p, lam)); if (kd[2] == -1, next);
        stats[1]++; if (kd[3] > 0, stats[2]++); if (kd[2] % znorder(Mod(lam, p)) == 0, stats[3]++);
        if (kd[3] == 0 && kd[2] % znorder(Mod(lam, p)) == 0, stats[4]++));
      printf("  target=%s source=%d: isogenies tested=%d  m0-socle>0: %d  ord(lam)|m_G: %d  (ord|m_G but socle=0: %d)\n", targets[it][3], is, stats[1], stats[2], stats[3], stats[4])));
  \\ cover-degree lattice for each ppav target
  my(al = AL, sq7 = SQ);
  for (it = 1, #targets, if (targets[it][2] == 0, next);
    my(T = targets[it][1], lamT = targets[it][2], M = mathnf(concat(T, mulmat(al) * T)), I = abs(matdet(T) / matdet(M)));
    my(n = #T, Tr = matrix(n, n, i, j, nfelttrace(NF, nfeltmul(NF, matid(n)[,i], matid(n)[,j]))));
    my(Mdual = (M~ * Tr)^-1);       \\ columns: trace-dual basis of M
    my(Lb = mulmat(sq7) * Mdual);    \\ L = sqrt-7 * M^dual
    my(w = nfeltdiv(NF, 1, nfeltmul(NF, sq7, lamT)));
    my(G = matrix(n, n, i, j, nfelttrace(NF, nfeltmul(NF, w, nfeltmul(NF, Lb[,i], cj(Lb[,j]))))));
    my(sg = qfsign(G)); if (sg[1] == 0, G = -G);
    my(Qf = G / 2, integ = (denominator(vector(n, i, Qf[i,i])) == 1));
    my(mn = qfminim(Qf, , 0, 2));
    printf("  [%s] I=[Z[alpha]T:T]=%s  signature=%s  det(G)=%s (7^%d * I^2 = %s)  Q(c) integral on basis: %d  d_min=%d  #min vectors=%d\n",
      targets[it][3], factor(I), sg, factor(abs(matdet(G))), n/2, factor(7^(n/2) * I^2), integ, round(mn[2]), mn[1]));
}
