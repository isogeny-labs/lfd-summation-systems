def coef3 {R : Type*} [CommRing R] (a b t : R) : Fin 5 → Fin 5 → R :=
  ![![(-4*a^4*t - 8*a^3*b + 8*a^2*b*t^2 - 32*a*b^2*t - 64*b^3 - 32*b^2*t^3), (-4*a^4 + 4*a^3*t^2 - 32*a*b^2 - 32*a*b*t^3 - 32*b^2*t^2), (4*a^3*t + 8*a^2*b + 4*a^2*t^3 - 8*a*b*t^2 - 32*b^2*t - 8*b*t^4), (4*a^2*t^2 - 32*a*b*t - 4*a*t^4 - 32*b^2 - 48*b*t^3), (-4*a*t^3 - 8*b*t^2)],
    ![(-4*a^4 + 4*a^3*t^2 - 32*a*b^2 - 32*a*b*t^3 - 32*b^2*t^2), (-24*a^3*t - 40*a^2*t^3 - 64*a*b*t^2 - 192*b^2*t + 16*b*t^4), (4*a^3 - 8*a^2*t^2 - 64*a*b*t + 4*a*t^4 - 32*b^2 + 16*b*t^3), (-40*a^2*t - 32*a*b - 24*a*t^3 + 16*b*t^2), (4*a*t^2 + 16*b*t - 4*t^4)],
