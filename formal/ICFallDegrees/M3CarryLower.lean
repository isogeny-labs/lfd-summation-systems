/-- Coefficients of `x1^4 x2^j x3^l` in `S_4(x1,x2,x3,t)`. -/
def coef4 {R : Type*} [CommRing R] (a b t : R) : Fin 5 → Fin 5 → R :=
  ![![(a^4 - 8*a^2*b*t + 16*b^2*t^2), (-4*a^3*t - 8*a^2*b + 16*a*b*t^2 + 32*b^2*t), (6*a^2*t^2 + 16*a*b*t + 16*b^2 - 8*b*t^3), (-4*a*t^3 - 8*b*t^2), (t^4)],
    ![(-4*a^3*t - 8*a^2*b + 16*a*b*t^2 + 32*b^2*t), (-4*a^3 + 4*a^2*t^2 + 48*a*b*t + 32*b^2 + 16*b*t^3), (4*a^2*t + 16*a*b + 4*a*t^3 + 24*b*t^2), (4*a*t^2 + 16*b*t - 4*t^4), (-4*t^3)],
    ![(6*a^2*t^2 + 16*a*b*t + 16*b^2 - 8*b*t^3), (4*a^2*t + 16*a*b + 4*a*t^3 + 24*b*t^2), (6*a^2 + 24*a*t^2 + 24*b*t + 6*t^4), (4*a*t - 8*b + 4*t^3), (6*t^2)],
    ![(-4*a*t^3 - 8*b*t^2), (4*a*t^2 + 16*b*t - 4*t^4), (4*a*t - 8*b + 4*t^3), (-4*a + 4*t^2), (-4*t)],
    ![(t^4), (-4*t^3), (6*t^2), (-4*t), (1)]]

/-- The coefficient of `x1^i x2^j x3^l` in `S_4(x1,x2,x3,t)` (generated by sympy from the
resultant formula; checked against it in `s4_eq_table`). -/
def coef {R : Type*} [CommRing R] (a b t : R) : Fin 5 → Fin 5 → Fin 5 → R :=
  ![coef0 a b t,coef1 a b t,coef2 a b t,coef3 a b t,coef4 a b t]


/-- The explicit expansion of `S_4(x1,x2,x3,t)`. -/
def table (a b t : K) : Z K :=
  ∑ x : Fin 5 × Fin 5 × Fin 5, monomial (expo x.1 x.2.1 x.2.2) (coef a b t x.1 x.2.1 x.2.2)

theorem monomial_expo (i j l : ℕ) (c : K) :
    monomial (expo i j l) c=C c*X 0^i*X 1^j*X 2^l := by
  rw [expo,monomial_add_single,monomial_add_single,← C_mul_X_pow_eq_monomial]

set_option maxHeartbeats 4000000 in
/-- The resultant formula expands to the coefficient table, over every commutative ring. -/
theorem S4_expand {R : Type*} [CommRing R] (a b x1 x2 x3 t : R) :
    S4 a b x1 x2 x3 t=∑ x : Fin 5 × Fin 5 × Fin 5,
      coef a b t x.1 x.2.1 x.2.2*x1^(x.1 : ℕ)*x2^(x.2.1 : ℕ)*x3^(x.2.2 : ℕ) := by
  simp only [Fintype.sum_prod_type,Fin.sum_univ_succ,Fin.sum_univ_zero,coef,
    coef0,coef1,coef2,coef3,coef4,Matrix.cons_val_zero,Matrix.cons_val_succ,Fin.val_zero,
    Fin.val_succ,zero_add,Nat.reduceAdd,add_zero]
  unfold S4 qA qB qC
  ring

set_option maxHeartbeats 1000000 in
/-- The coefficient table commutes with ring homomorphisms (its entries are integer
polynomials in `a, b, t`). -/
theorem map_coef {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (a b t : R) :
    ∀ i j l, f (coef a b t i j l)=coef (f a) (f b) (f t) i j l := by
  simp only [Fin.forall_fin_succ,IsEmpty.forall_iff,coef,coef0,coef1,coef2,coef3,coef4,
    Matrix.cons_val_zero,Matrix.cons_val_succ,map_add,map_sub,map_mul,map_neg,map_pow,
    map_ofNat,map_zero,map_one,and_self,and_true,true_and]

/-- The expansion of `S_4(x1,x2,x3,t)` as a polynomial. -/
theorem s4_eq_table (a b t : K) : s4 a b t=table a b t := by
  rw [s4,S4_expand,table]
  apply Finset.sum_congr rfl
  intro x _
  rw [monomial_expo,map_coef]

theorem expo_apply (i j l : ℕ) : expo i j l 0=i ∧ expo i j l 1=j ∧ expo i j l 2=l := by
  simp [expo,Finsupp.single_apply]

theorem expo_injective {i j l i' j' l' : ℕ} (h : expo i j l=expo i' j' l') :
    i=i' ∧ j=j' ∧ l=l' := by
  have h0 := congrArg (fun s : Fin 3 →₀ ℕ => s 0) h
  have h1 := congrArg (fun s : Fin 3 →₀ ℕ => s 1) h
  have h2 := congrArg (fun s : Fin 3 →₀ ℕ => s 2) h
  simp only [(expo_apply _ _ _).1,(expo_apply _ _ _).2.1,(expo_apply _ _ _).2.2] at h0 h1 h2
  exact ⟨h0,h1,h2⟩

theorem table_support {a b t : K} {s : Fin 3 →₀ ℕ} (hs : s∈(table a b t).support) :
    ∀ i, s i≤4 := by
  classical
  obtain ⟨x,-,hx⟩ := Finset.mem_biUnion.mp (support_sum hs)
  have hx := Finset.mem_singleton.mp (support_monomial_subset hx)
  intro i
  rw [hx]
  have b0 := x.1.isLt
  have b1 := x.2.1.isLt
  have b2 := x.2.2.isLt
  fin_cases i <;> simp [expo,Finsupp.single_apply] <;> omega

theorem coeff_table (a b t : K) (x : Fin 5 × Fin 5 × Fin 5) :
    coeff (expo x.1 x.2.1 x.2.2) (table a b t)=coef a b t x.1 x.2.1 x.2.2 := by
  classical
  unfold table
  rw [coeff_sum,Finset.sum_eq_single x]
  · simp
  · intro y _ hne
    rw [coeff_monomial,if_neg]
    intro heq
    obtain ⟨h0,h1,h2⟩ := expo_injective heq
    exact hne (Prod.ext (Fin.ext h0) (Prod.ext (Fin.ext h1) (Fin.ext h2)))
  · intro h
    exact absurd (Finset.mem_univ x) h

theorem coef_333 (a b t : K) : coef a b t 3 3 3=-8*(5*t^3+3*a*t+6*b) := by
  have entry : coef a b t 3 3 3=-24*a*t-48*b-40*t^3 := rfl
  rw [entry]
  ring

/-- `[x1^3 x2^3 x3^3] S_4(x1,x2,x3,t) = -8(5t^3+3at+6b)`. -/
theorem coeff_s4_333 (a b t : K) : coeff (expo 3 3 3) (s4 a b t)=-8*(5*t^3+3*a*t+6*b) := by
  rw [s4_eq_table]
  have := coeff_table a b t (3,3,3)
  simp only at this
  rw [← coef_333 a b t, ← this]
  rfl

theorem s4_support {a b t : K} {s : Fin 3 →₀ ℕ} (hs : s∈(s4 a b t).support) : ∀ i, s i≤4 := by
  rw [s4_eq_table] at hs
  exact table_support hs

theorem x1_s4_support {a b t : K} {s : Fin 3 →₀ ℕ} (hs : s∈(X 0*s4 a b t).support) :
    ∀ i, s i≤5 := by
  rw [support_X_mul] at hs
  obtain ⟨s',hs',rfl⟩ := Finset.mem_map.mp hs
  intro i
  have := s4_support hs' i
  simp only [addLeftEmbedding_apply,Finsupp.coe_add,Pi.add_apply,Finsupp.single_apply]
  split_ifs <;> omega

/-! ## Binary chain normal forms -/

/-- The chain exponent of `x1^(e 0) x2^(e 1) x3^(e 2)`: bit `j` of `e i` at the chain
variable `u_{i,j}`. -/
def maskExp (k : ℕ) (e : Fin 3 →₀ ℕ) : Fin (3*k) →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun v => if (e (row v)).testBit (depth v) then 1 else 0

theorem maskExp_apply (k : ℕ) (e : Fin 3 →₀ ℕ) (v : Fin (3*k)) :
    maskExp k e v=if (e (row v)).testBit (depth v) then 1 else 0 := rfl

theorem maskExp_var (k : ℕ) (e : Fin 3 →₀ ℕ) (i : Fin 3) (j : Fin k) :
    maskExp k e (var 3 k i j)=if (e i).testBit j then 1 else 0 := by
  rw [maskExp_apply,row_var,depth_var]

theorem maskExp_equiv (k : ℕ) (e : Fin 3 →₀ ℕ) (i : Fin 3) (j : Fin k) :
    maskExp k e (finProdFinEquiv (i,j))=if (e i).testBit j then 1 else 0 :=
  maskExp_var k e i j

theorem maskExp_le_one (k : ℕ) (e : Fin 3 →₀ ℕ) (v : Fin (3*k)) : maskExp k e v≤1 := by
  rw [maskExp_apply]; split <;> omega

theorem maskExp_injective {k : ℕ} {e e' : Fin 3 →₀ ℕ} (he : ∀ i, e i<2^k) (he' : ∀ i, e' i<2^k)
    (h : maskExp k e=maskExp k e') : e=e' := by
  ext i
  apply Nat.eq_of_testBit_eq
  intro j
  by_cases hj : j<k
  · have := congrArg (fun s : Fin (3*k) →₀ ℕ => s (var 3 k i ⟨j,hj⟩)) h
    simp only [maskExp_var] at this
    cases h1 : (e i).testBit j <;> cases h2 : (e' i).testBit j <;> simp_all
  · have large : 2^k≤2^j := Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [Nat.testBit_lt_two_pow ((he i).trans_le large),
      Nat.testBit_lt_two_pow ((he' i).trans_le large)]

/-- The chain normal form of a polynomial with small exponents: each monomial
`x^e` goes to the squarefree chain monomial of the binary digits of `e`. -/
def lift (k : ℕ) (p : Z K) : P (3*k) K :=
  ∑ e∈p.support, monomial (maskExp k e) (coeff e p)

theorem mem_support_lift {k : ℕ} {p : Z K} {s : Fin (3*k) →₀ ℕ} (hs : s∈(lift k p).support) :
    ∃ e∈p.support, s=maskExp k e := by
  classical
  obtain ⟨e,he,hs⟩ := Finset.mem_biUnion.mp (support_sum hs)
  exact ⟨e,he,Finset.mem_singleton.mp (support_monomial_subset hs)⟩

theorem lift_reduced (k : ℕ) (p : Z K) : lift k p∈reducedSpace (chainInputs K 3 k) := by
  intro s hs g hg
  obtain ⟨e,-,rfl⟩ := mem_support_lift hs
  obtain ⟨v,rfl⟩ := hg
  rw [leading_chainPolynomial,Finsupp.single_le_iff]
  have := maskExp_le_one k e v
  omega

theorem coeff_lift {k : ℕ} {p : Z K} {e : Fin 3 →₀ ℕ}
    (hp : ∀ s∈p.support, ∀ i, s i<2^k) (he : ∀ i, e i<2^k) :
    coeff (maskExp k e) (lift k p)=coeff e p := by
  classical
  unfold lift
  rw [coeff_sum]
  simp only [coeff_monomial]
  by_cases hmem : e∈p.support
  · rw [Finset.sum_eq_single e]
    · simp
    · intro s hs hne
      rw [if_neg]
      intro heq
      exact hne (maskExp_injective (hp s hs) he heq)
    · intro h
      exact absurd hmem h
  · rw [Finset.sum_eq_zero,eq_comm]
    · exact not_mem_support_iff.mp hmem
    · intro s hs
      rw [if_neg]
      intro heq
      exact hmem (maskExp_injective (hp s hs) he heq ▸ hs)

/-- Number of binary digits among the lowest three. -/
def bitCount (x : ℕ) : ℕ :=
  (if x.testBit 0 then 1 else 0)+(if x.testBit 1 then 1 else 0)+(if x.testBit 2 then 1 else 0)

theorem testBit_high {x : ℕ} (hx : x≤5) (n : ℕ) {j : ℕ} (hj : j=n+3) : x.testBit j=false := by
  apply Nat.testBit_lt_two_pow
  calc x<8 := by omega
    _ = 2^3 := by norm_num
    _ ≤ 2^j := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem sum_bits (n x : ℕ) (hx : x≤5) :
    ∑ j : Fin (n+3), (if x.testBit j then 1 else 0)=bitCount x := by
  rw [Fin.sum_univ_succ,Fin.sum_univ_succ,Fin.sum_univ_succ]
  have rest : ∑ j : Fin n, (if x.testBit ((j.succ.succ.succ : Fin (n+3)) : ℕ) then 1 else 0)=0 := by
    apply Finset.sum_eq_zero
    intro j _
    rw [testBit_high hx j (by simp [Fin.val_succ])]
    rfl
  rw [rest,add_zero,bitCount]
  simp only [Fin.val_zero,Fin.val_succ,zero_add,Nat.reduceAdd]
  omega

theorem bitCount_le (x : ℕ) (hx : x≤5) : bitCount x≤2 := by
  interval_cases x <;> simp [bitCount,Nat.testBit_to_div_mod]

theorem bitCount_three : bitCount 3=2 := by simp [bitCount,Nat.testBit_to_div_mod]

theorem maskExp_sum (n : ℕ) (e : Fin 3 →₀ ℕ) (he : ∀ i, e i≤5) :
    ((maskExp (n+3) e).sum fun _ m => m)=bitCount (e 0)+bitCount (e 1)+bitCount (e 2) := by
  rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
  rw [← Fintype.sum_equiv finProdFinEquiv (fun ij => maskExp (n+3) e (finProdFinEquiv ij)) _
    (fun _ => rfl)]
  rw [Fintype.sum_prod_type]
  simp only [maskExp_var,maskExp_equiv]
  rw [Fin.sum_univ_three,sum_bits n _ (he 0),sum_bits n _ (he 1),sum_bits n _ (he 2)]

theorem lift_totalDegree_le (n : ℕ) (p : Z K) (hp : ∀ s∈p.support, ∀ i, s i≤5) :
    (lift (n+3) p).totalDegree≤6 := by
  apply (totalDegree_finset_sum _ _).trans
  apply Finset.sup_le
  intro e he
  apply (totalDegree_monomial_le _ _).trans
  have key : ((maskExp (n+3) e).sum fun _ => id)=bitCount (e 0)+bitCount (e 1)+bitCount (e 2) :=
    maskExp_sum n e (hp e he)
  rw [key]
  have := bitCount_le _ (hp e he 0)
  have := bitCount_le _ (hp e he 1)
  have := bitCount_le _ (hp e he 2)
  omega

/-! ## The lift is the chain normal form -/

/-- The chain substitution `x_i ↦ u_{i,0}`. -/
def toChain (k : ℕ) (hk : 0<k) : Z K →ₐ[K] P (3*k) K :=
  rename fun i => var 3 k i ⟨0,hk⟩

theorem chain_square (k : ℕ) (i : Fin 3) (j j' : Fin k) (h : (j' : ℕ)=j+1) :
    Ideal.Quotient.mk (Ideal.span (chainInputs K 3 k)) (X (var 3 k i j))^2=
      Ideal.Quotient.mk (Ideal.span (chainInputs K 3 k)) (X (var 3 k i j')) := by
  have mem : chainPolynomial K 3 k (var 3 k i j)∈Ideal.span (chainInputs K 3 k) :=
    Ideal.subset_span ⟨_,rfl⟩
  have tail : chainTail K 3 k (var 3 k i j)=X (var 3 k i j') := by
    unfold chainTail
    split_ifs with hlt
    · congr 2
      · exact row_var 3 k i j
      · apply Fin.ext
        simp only [depth_var, h]
    · exfalso
      rw [depth_var] at hlt
      have := j'.isLt
      omega
  rw [← map_pow,Ideal.Quotient.eq]
  simpa [chainPolynomial,tail] using mem

theorem pow_digits {R : Type*} [CommRing R] (y0 y1 y2 : R) (r0 : y0^2=y1) (r1 : y1^2=y2)
    (x : ℕ) (hx : x≤5) :
    y0^(if x.testBit 0 then 1 else 0)*(y1^(if x.testBit 1 then 1 else 0)*
      (y2^(if x.testBit 2 then 1 else 0)))=y0^x := by
  interval_cases x <;> simp [Nat.testBit_to_div_mod]
  · linear_combination -r0
  · linear_combination (-y0)*r0
  · linear_combination (-(y0^2+y1))*r0-r1
  · linear_combination (-y0*(y0^2+y1))*r0-y0*r1

theorem block (n : ℕ) (i : Fin 3) (x : ℕ) (hx : x≤5) :
    ∏ j : Fin (n+3), Ideal.Quotient.mk (Ideal.span (chainInputs K 3 (n+3)))
        (X (var 3 (n+3) i j))^(if x.testBit j then 1 else 0)=
      Ideal.Quotient.mk (Ideal.span (chainInputs K 3 (n+3))) (X (var 3 (n+3) i ⟨0,by omega⟩))^x := by
  rw [Fin.prod_univ_succ,Fin.prod_univ_succ,Fin.prod_univ_succ]
  have rest : ∏ j : Fin n, Ideal.Quotient.mk (Ideal.span (chainInputs K 3 (n+3)))
      (X (var 3 (n+3) i j.succ.succ.succ))^(if x.testBit ((j.succ.succ.succ : Fin (n+3)) : ℕ)
        then 1 else 0)=1 := by
    apply Finset.prod_eq_one
    intro j _
    rw [testBit_high hx j (by simp [Fin.val_succ])]
    simp
  rw [rest,mul_one]
  have r0 := chain_square (K := K) (n+3) i 0 (0 : Fin (n+2)).succ (by simp)
  have r1 := chain_square (K := K) (n+3) i (0 : Fin (n+2)).succ (0 : Fin (n+1)).succ.succ
    (by simp)
  have v1 : (((0 : Fin (n+2)).succ : Fin (n+3)) : ℕ)=1 := by simp
  have v2 : (((0 : Fin (n+1)).succ.succ : Fin (n+3)) : ℕ)=2 := by simp
  have v0 : ((0 : Fin (n+3)) : ℕ)=0 := by simp
  have e0 : (⟨0,by omega⟩ : Fin (n+3))=0 := Fin.ext (by simp)
  rw [v0,v1,v2,e0]
  exact pow_digits _ _ _ r0 r1 x hx

theorem monomial_maskExp (k : ℕ) (e : Fin 3 →₀ ℕ) (c : K) :
    monomial (maskExp k e) c=C c*∏ i : Fin 3, ∏ j : Fin k,
      X (var 3 k i j)^(if (e i).testBit j then 1 else 0) := by
  rw [monomial_eq,Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  congr 1
  rw [← Fintype.prod_equiv finProdFinEquiv (fun ij => X (finProdFinEquiv ij)^maskExp k e
    (finProdFinEquiv ij)) _ (fun _ => rfl)]
  rw [Fintype.prod_prod_type]
  simp only [maskExp_var,maskExp_equiv]

theorem monomial_congr (n : ℕ) (e : Fin 3 →₀ ℕ) (he : ∀ i, e i≤5) (c : K) :
    Ideal.Quotient.mk (Ideal.span (chainInputs K 3 (n+3))) (monomial (maskExp (n+3) e) c)=
      Ideal.Quotient.mk (Ideal.span (chainInputs K 3 (n+3)))
        (toChain (n+3) (by omega) (monomial e c)) := by
  rw [monomial_maskExp,toChain,rename_monomial,monomial_eq,
    Finsupp.prod_mapDomain_index (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
    Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  simp only [map_mul,map_prod,map_pow]
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  exact block n i (e i) (he i)

/-- The lift is congruent to the chain substitution modulo the chains. -/
theorem lift_congr (n : ℕ) (p : Z K) (hp : ∀ s∈p.support, ∀ i, s i≤5) :
    lift (n+3) p-toChain (n+3) (by omega) p∈Ideal.span (chainInputs K 3 (n+3)) := by
  rw [← Ideal.Quotient.eq]
  conv_rhs => rw [p.as_sum]
  unfold lift
  rw [map_sum,map_sum,map_sum]
  apply Finset.sum_congr rfl
  intro e he
  exact monomial_congr n e (hp e he) _

/-! ## The direct `m = 3` system -/

/-- The chain normal form `g = NF(S_4(x1,x2,x3,t))` of the direct three-summand system. -/
def chainS4 (k : ℕ) (a b t : K) : P (3*k) K := lift k (s4 a b t)

/-- The carried row `h = NF(u_{1,0} * g)`. -/
def carryS4 (k : ℕ) (a b t : K) : P (3*k) K := lift k (X 0*s4 a b t)

/-- `g` is a chain normal form of `S_4(u_{1,0},u_{2,0},u_{3,0},t)`: reduced (squarefree), and
congruent to it modulo the chains. By `FiniteQuotient.reduced_unique_of_reduced_zero` it is the
unique such polynomial. -/
theorem chainS4_normal_form (k : ℕ) (hk : 3≤k) (a b t : K) :
    chainS4 k a b t∈reducedSpace (chainInputs K 3 k) ∧
      chainS4 k a b t-toChain k (by omega) (s4 a b t)∈Ideal.span (chainInputs K 3 k) := by
  obtain ⟨n,rfl⟩ : ∃ n, k=n+3 := ⟨k-3,by omega⟩
  exact ⟨lift_reduced _ _,lift_congr n _ (fun s hs i => (s4_support hs i).trans (by norm_num))⟩

theorem small_lt_two_pow (n : ℕ) {x : ℕ} (hx : x≤5) : x<2^(n+3) :=
  calc x<2^3 := by norm_num; omega
    _ ≤ 2^(n+3) := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem chainS4_totalDegree (two_ne : (2 : K)≠0) (n : ℕ) (a b t : K)
    (nondegenerate : 5*t^3+3*a*t+6*b≠0) : (chainS4 (n+3) a b t).totalDegree=6 := by
  have small : ∀ s∈(s4 a b t).support, ∀ i, s i≤5 :=
    fun s hs i => (s4_support hs i).trans (by norm_num)
  apply le_antisymm (lift_totalDegree_le n _ small)
  have e333 : ∀ i, expo 3 3 3 i≤5 := by
    intro i; fin_cases i <;> simp [expo,Finsupp.single_apply]
  have coefficient : coeff (maskExp (n+3) (expo 3 3 3)) (chainS4 (n+3) a b t)≠0 := by
    rw [chainS4,coeff_lift (fun s hs i => small_lt_two_pow n (small s hs i))
      (fun i => small_lt_two_pow n (e333 i)),coeff_s4_333]
    have eight : (-8 : K)≠0 := by
      have : (-8 : K)=-(2^3) := by norm_num
      rw [this]
      exact neg_ne_zero.mpr (pow_ne_zero _ two_ne)
    exact mul_ne_zero eight nondegenerate
  have := le_totalDegree (mem_support_iff.mpr coefficient)
  rw [maskExp_sum n _ e333] at this
  have three : ∀ i, expo 3 3 3 i=3 := by
    intro i; fin_cases i <;> simp [expo,Finsupp.single_apply]
  rw [three,three,three,bitCount_three] at this
  exact this

theorem carry_not_multiple (two_ne : (2 : K)≠0) (n : ℕ) (a b t : K)
    (nondegenerate : 5*t^3+3*a*t+6*b≠0) (c : K) :
    carryS4 (n+3) a b t≠c • chainS4 (n+3) a b t := by
  intro equal
  have small : ∀ s∈(s4 a b t).support, ∀ i, s i<2^(n+3) :=
    fun s hs i => small_lt_two_pow n ((s4_support hs i).trans (by norm_num))
  have small' : ∀ s∈(X 0*s4 a b t).support, ∀ i, s i<2^(n+3) :=
    fun s hs i => small_lt_two_pow n (x1_s4_support hs i)
  have polynomial : X 0*s4 a b t=C c*s4 a b t := by
    ext e
    by_cases he : ∀ i, e i<2^(n+3)
    · have := congrArg (coeff (maskExp (n+3) e)) equal
      rw [carryS4,coeff_smul,chainS4,coeff_lift small' he,coeff_lift small he] at this
      rw [this,coeff_C_mul,smul_eq_mul]
    · push_neg at he
      obtain ⟨i,hi⟩ := he
      have z1 : coeff e (X 0*s4 a b t)=0 := by
        by_contra nz
        exact absurd (small' e (mem_support_iff.mpr nz) i) (not_lt.mpr hi)
      have z2 : coeff e (s4 a b t)=0 := by
        by_contra nz
        exact absurd (small e (mem_support_iff.mpr nz) i) (not_lt.mpr hi)
      rw [z1,coeff_C_mul,z2,mul_zero]
  have factor : (X 0-C c)*s4 a b t=0 := by rw [sub_mul,polynomial,sub_self]
  have linear : (X 0-C c : Z K)≠0 := by
    intro zero
    have := congrArg (coeff (Finsupp.single 0 1)) zero
    rw [coeff_sub,coeff_X,coeff_C,if_neg] at this
    · simp at this
    · intro h
      have := congrArg (fun s : Fin 3 →₀ ℕ => s 0) h
      simp at this
  have nonzero : s4 a b t≠0 := by
    intro zero
    have := coeff_s4_333 a b t
    rw [zero,coeff_zero] at this
    have eight : (-8 : K)≠0 := by
      have : (-8 : K)=-(2^3) := by norm_num
      rw [this]
      exact neg_ne_zero.mpr (pow_ne_zero _ two_ne)
    exact mul_ne_zero eight nondegenerate this.symm
  exact nonzero ((mul_eq_zero.mp factor).resolve_left linear)

/-- **Direct `m = 3` lower bound (N2).** For three summands with squaring chains of depth
`k ≥ 3` over a field with `2 ≠ 0`, every curve `y^2 = x^3 + a x + b` and every target
abscissa `t` with `5t^3 + 3at + 6b ≠ 0`, the system made of the `3k` chain equations and the
chain normal form of `S_4(x1,x2,x3,t)` has `LFD ≥ 7`: no `e ≤ 6` is an LFD bound. -/
theorem m3_lfd_ge_seven (two_ne : (2 : K)≠0) (k : ℕ) (hk : 3≤k) (a b t : K)
    (nondegenerate : 5*t^3+3*a*t+6*b≠0) :
    ∀ e≤6, ¬HasLFDBound (chainInputs K 3 k∪{chainS4 k a b t}) e := by
  obtain ⟨n,rfl⟩ : ∃ n, k=n+3 := ⟨k-3,by omega⟩
  have small : ∀ s∈(s4 a b t).support, ∀ i, s i≤5 :=
    fun s hs i => (s4_support hs i).trans (by norm_num)
  apply CarryLower.chain_carry_lower 3 (n+3) two_ne (chainS4 (n+3) a b t) (carryS4 (n+3) a b t)
    (var 3 (n+3) 0 ⟨0,by omega⟩) 6 (lift_reduced _ _)
    (chainS4_totalDegree two_ne n a b t nondegenerate) (lift_reduced _ _)
    (lift_totalDegree_le n _ (fun s hs => x1_s4_support hs)) ?_
    (carry_not_multiple two_ne n a b t nondegenerate)
  -- `h - u_{1,0} g ∈ (chains)`.
  have hcong := lift_congr (K := K) n (X 0*s4 a b t) (fun s hs => x1_s4_support hs)
  have gcong := lift_congr (K := K) n (s4 a b t) small
  have identity : carryS4 (n+3) a b t-X (var 3 (n+3) 0 ⟨0,by omega⟩)*chainS4 (n+3) a b t=
      (lift (n+3) (X 0*s4 a b t)-toChain (n+3) (by omega) (X 0*s4 a b t))-
        X (var 3 (n+3) 0 ⟨0,by omega⟩)*(lift (n+3) (s4 a b t)-toChain (n+3) (by omega) (s4 a b t)) := by
    simp only [map_mul,toChain,rename_X,carryS4,chainS4]
    ring
  rw [identity]
  exact Ideal.sub_mem _ hcong (Ideal.mul_mem_left _ _ gcong)

/-- Prime-field entry point: every prime `p ≥ 5`, depth `k ≥ 3`, curve and target with
`5t^3 + 3at + 6b ≠ 0`. -/
theorem prime_field_m3_lfd_ge_seven (p : ℕ) [Fact p.Prime] (large : 5≤p) (k : ℕ) (hk : 3≤k)
    (a b t : ZMod p) (nondegenerate : 5*t^3+3*a*t+6*b≠0) :
    ∀ e≤6, ¬HasLFDBound (chainInputs (ZMod p) 3 k∪{chainS4 k a b t}) e :=
  m3_lfd_ge_seven (PrimeFieldConclusions.two_ne_zero p large) k hk a b t nondegenerate

end ICFallDegrees.M3CarryLower
