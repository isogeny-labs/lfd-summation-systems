import ICFallDegrees.CarryLower

noncomputable section

/-!
# A direct `m = 3` lower bound from the carry lemma (N2)

For three summands with squaring chains of depth `k ≥ 3` over a field with
`2 ≠ 0`, let `g` be the chain normal form of `S_4(x1,x2,x3,t)`, where
`S_4(x1,x2,x3,x4) = Res_X(S_3(x1,x2,X), S_3(x3,x4,X))` (written with the closed
two-quadratic resultant formula) and `S_3` is the third summation polynomial of
`y^2 = x^3 + a x + b`. If `5t^3 + 3at + 6b ≠ 0`, then the system
`chains ∪ {g}` has `LFD ≥ 7`: no `e ≤ 6` is a last-fall-degree bound
(Corollary 2 of `experiments/ic-bounds-m3/README.md`).

Ingredients, all kernel-checked here:
* `S4_expand` / `s4_eq_table`: the 125-coefficient expansion of `S_4` in `x1,x2,x3`
  (exponents `0..4`; table generated by sympy, checked by `ring` over every commutative
  ring); in particular `[x1^3 x2^3 x3^3] S_4 = -8(5t^3+3at+6b)` (`coeff_s4_333`).
* `lift`: the chain normal form of a polynomial whose exponents are at most `5`,
  sending `x_i^e` to the squarefree chain monomial of the binary digits of `e`
  (`lift_congr`: congruent modulo the chains; `lift_reduced`: reduced).
* the only exponent triple with digit weight 6 among exponents `≤ 4` is
  `(3,3,3)`, so `deg g = 6`, and `h = NF(u_{1,0} g) = lift (x1 * S_4)` has
  degree at most 6 (exponents `≤ 5`, digit weight `≤ 2` each).
* `h` is not a scalar multiple of `g`: the lift is injective on exponents below
  `2^k`, so `h = c g` would give `x1 * S_4 = c * S_4` as polynomials, hence
  `S_4 = 0`. This replaces the slice count of the written proof (for `k ≥ 3`
  no counting of zeros on `H^3` is needed).
-/

namespace ICFallDegrees.M3CarryLower

open MvPolynomial FiniteQuotient ChainQuotient

variable {K : Type*} [Field K]

/-! ## The summation polynomials -/

/-- Coefficients of `S_3(u,v,w) = A w^2 + B w + C` as a quadratic in `w`. -/
def qA {R : Type*} [CommRing R] (u v : R) : R := (u-v)^2
def qB {R : Type*} [CommRing R] (a b u v : R) : R := -2*((u+v)*(u*v+a)+2*b)
def qC {R : Type*} [CommRing R] (a b u v : R) : R := (u*v-a)^2-4*b*(u+v)

/-- The third summation polynomial of `y^2 = x^3 + a x + b`. -/
def S3 {R : Type*} [CommRing R] (a b u v w : R) : R :=
  (u-v)^2*w^2-2*((u+v)*(u*v+a)+2*b)*w+(u*v-a)^2-4*b*(u+v)

theorem S3_quadratic {R : Type*} [CommRing R] (a b u v w : R) :
    S3 a b u v w=qA u v*w^2+qB a b u v*w+qC a b u v := by
  unfold S3 qA qB qC; ring

/-- `S_4(x1,x2,x3,x4) = Res_X(S_3(x1,x2,X), S_3(x3,x4,X))`, through the closed form
`Res(A X^2+B X+C, A' X^2+B' X+C') = (A C' - A' C)^2 - (A B' - A' B)(B C' - B' C)`. -/
def S4 {R : Type*} [CommRing R] (a b x1 x2 x3 x4 : R) : R :=
  (qA x1 x2*qC a b x3 x4-qA x3 x4*qC a b x1 x2)^2-
    (qA x1 x2*qB a b x3 x4-qA x3 x4*qB a b x1 x2)*(qB a b x1 x2*qC a b x3 x4-qB a b x3 x4*qC a b x1 x2)

/-- Polynomials in the three summand coordinates `x1, x2, x3` (`X 0, X 1, X 2`). -/
abbrev Z (K : Type*) [Field K] := MvPolynomial (Fin 3) K

/-- `S_4(x1,x2,x3,t)` with the target abscissa `t` fixed. -/
def s4 (a b t : K) : Z K := S4 (C a) (C b) (X 0) (X 1) (X 2) (C t)

/-- The exponent of `x1^i x2^j x3^l`. -/
def expo (i j l : ℕ) : Fin 3 →₀ ℕ :=
  Finsupp.single 0 i+Finsupp.single 1 j+Finsupp.single 2 l

